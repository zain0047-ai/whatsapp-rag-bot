# =========================================
# APP
# =========================================
APP_ENV=development                 # development | staging | production
APP_SECRET_KEY=change_me_to_a_long_random_string
LOG_LEVEL=INFO

# =========================================
# DATABASE (PostgreSQL + pgvector)
# =========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_rag_bot

# =========================================
# REDIS (short-term memory, rate limiting, job queue)
# =========================================
REDIS_URL=redis://localhost:6379/0

# =========================================
# LLM (Anthropic Claude)
# =========================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# =========================================
# EMBEDDINGS (OpenAI text-embedding-3-small)
# =========================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =========================================
# WHATSAPP CLOUD API (Meta)
# =========================================
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxx
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxx
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_your_own_verify_string
WHATSAPP_API_VERSION=v20.0

# =========================================
# ADMIN PANEL AUTH
# =========================================
ADMIN_JWT_SECRET=change_me_to_a_long_random_string
ADMIN_JWT_EXPIRE_MINUTES=120

# =========================================
# RAG CONFIG
# =========================================
RETRIEVAL_TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.55
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# =========================================
# RATE LIMITING
# =========================================
RATE_LIMIT_PER_MINUTE=30
